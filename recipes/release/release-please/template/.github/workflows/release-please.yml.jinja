name: release-please

# Maintains a release pull request from the Conventional Commits on the default branch.
# Merging it tags the version and writes the changelog, which is why the commit-msg hook
# and the CI check on the range matter: the subject type decides the bump.
#
# Its own workflow rather than a job in the gate. It needs `contents: write` and
# `pull-requests: write`, which the gate deliberately does not carry, and it runs on
# push to the default branch rather than per pull request.

on:
  push:
    branches:
      - {{ default_branch }}

permissions:
  contents: read

jobs:
  release-please:
    name: Release pull request
    runs-on: ubuntu-latest
    # GitHub defaults to 360 minutes, so a hung job burns six runner hours.
    timeout-minutes: 15
    permissions:
      # Writes the tag and the changelog commit.
      contents: write
      # Opens and updates the release pull request.
      pull-requests: write
      issues: write
    steps:
{%- if release_app %}
      # A pull request opened with GITHUB_TOKEN triggers no workflow. GitHub refuses this on
      # purpose, to stop a workflow from causing its own next run, so the release pull request
      # reports no checks and a required check blocks it forever. An App token is not subject to
      # that, which is the only reason this step exists.
      #
      # `vars` for the client id and `secrets` for the key: the id is not sensitive, and keeping
      # it visible makes a wrong-app failure readable.
      # Fails the run when either credential is missing or empty, rather than continuing with
      # GITHUB_TOKEN. A pull request opened with that token carries no checks, so a fallback
      # produces a release pull request nobody can merge while the run reports success -- the
      # failure would surface later, as a blocked pull request, with nothing pointing at the
      # cause.
      #
      # The length check is what catches an empty secret. One was set from a `op read` whose
      # 1Password session had timed out mid-pipe: the write reported success and stored nothing,
      # and every later run died inside the action with `DataError: Invalid keyData`.
      #
      # `secrets` is unavailable in a step-level `if`, which actionlint reports, so the check
      # reads both through env.
      - name: Require the release app credentials
        env:
          CLIENT_ID: ${{ '{{' }} vars.RELEASE_APP_CLIENT_ID }}
          PRIVATE_KEY: ${{ '{{' }} secrets.RELEASE_APP_PRIVATE_KEY }}
        run: |
          {%- raw %}
          set -euo pipefail
          if [ -z "$CLIENT_ID" ]; then
            echo "::error::RELEASE_APP_CLIENT_ID is not set on this repository"
            exit 1
          fi
          # A PEM private key is well over a kilobyte. Anything shorter is not one.
          # `${#name}` in the template opens jinja's comment tag, so this body is in `raw`:
          # copier otherwise fails with "Missing end of comment tag" and names no line.
          if [ "${#PRIVATE_KEY}" -lt 1000 ]; then
            echo "::error::RELEASE_APP_PRIVATE_KEY is empty or truncated (${#PRIVATE_KEY} bytes)"
            exit 1
          fi
          {%- endraw %}

      # Reached only when both credentials passed the check above. Without that check this
      # action's own failure is opaque: an empty key exits with `DataError: Invalid keyData` and
      # an asn1 `not enough data`, which reads as a malformed key rather than a missing one.
      - name: Mint the release app token
        id: app-token
        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0
        with:
          app-id: ${{ '{{' }} vars.RELEASE_APP_CLIENT_ID }}
          private-key: ${{ '{{' }} secrets.RELEASE_APP_PRIVATE_KEY }}
          # Scoped, not blanket. An App token defaults to every permission its installation
          # holds, which zizmor reports as `github-app` at HIGH: the token would carry write
          # access to anything the App can reach, in a job that only needs to open one pull
          # request. These two are what release-please uses -- commits and tags, then the pull
          # request itself.
          permission-contents: write
          permission-pull-requests: write
{%- endif %}

{%- if release_app and sync_generated %}

      # The sync step below needs a working tree and the toolchain that regenerates the
      # catalogs. Checked out with the App token persisted, so its push authors a commit that
      # triggers the required checks; the default token's commits do not.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The release branch is fetched by name below, so the full history is needed.
          fetch-depth: 0
          # Not persisted. A token left in `.git/config` is what zizmor reports as
          # `artipacked`, and it is avoidable here: the sync step passes the credential in the
          # remote URL instead, so it never lands on disk.
          persist-credentials: false

      - uses: jdx/mise-action@9e7f7633ff6f6d6048a9418a68d48f288f50eb14 # v4.2.3
        with:
          # This job pushes a commit onto a branch that will be released, so a poisoned cache
          # entry would reach a published artefact. Same reason release/goreleaser sets it.
          cache: false
{%- endif %}

      - uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
        id: release
        with:
{%- if release_app %}
          # No `|| secrets.GITHUB_TOKEN` fallback. The step above already failed the run if the
          # credentials were missing, and a release pull request opened with GITHUB_TOKEN carries
          # no checks, so falling back would only hide the problem.
          token: ${{ '{{' }} steps.app-token.outputs.token }}
{%- else %}
          # GITHUB_TOKEN, so the release pull request will carry no checks. A required check
          # then blocks it, and merging needs an admin override. Set `release_app` and provide
          # the two credentials to avoid that.
          token: ${{ '{{' }} secrets.GITHUB_TOKEN }}
{%- endif %}
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json
{%- if release_app and sync_generated %}

      # The marketplace catalogs repeat each plugin's version, and release-please bumps only
      # the files its config names. Once that config names the plugin manifests -- the
      # per-plugin `extra-files` shape a marketplace grows into past its first plugin -- both
      # catalogs go stale the moment the release pull request opens, and `just
      # marketplace-check` fails on the drift. Under the plain single-component config
      # nothing the catalogs carry moves, and the step reports "already in sync".
      #
      # Amending them onto the release branch is what clears it. The push uses the App token, so
      # the resulting commit triggers the required checks; a GITHUB_TOKEN push would not, and the
      # pull request would stay blocked on checks that never ran.
      - name: Sync the generated catalogs onto the release branch
        if: ${{ '{{' }} steps.release.outputs.pr }}
        env:
          # Step-level `env` is evaluated even when `if` is false, so the parse is guarded too:
          # a bare `fromJSON('')` aborts the whole job with "Error reading JToken".
          RELEASE_BRANCH: >-
            ${{ '{{' }} steps.release.outputs.pr
            && fromJSON(steps.release.outputs.pr).headBranchName || '' }}
          GH_TOKEN: ${{ '{{' }} steps.app-token.outputs.token }}
        run: |
          set -euo pipefail
          git fetch "https://x-access-token:$GH_TOKEN@github.com/$GITHUB_REPOSITORY" "$RELEASE_BRANCH"
          git checkout FETCH_HEAD

          # `marketplace-build` is the recipe agentic/package ships. Checked rather than
          # assumed: just reports `justfile does not contain recipe` and exits 1, which reads as
          # a broken workflow rather than a layer that never rendered. This repository hit
          # exactly that.
          if ! just --list 2>/dev/null | grep -q 'marketplace-build'; then
            echo "::error::no marketplace-build recipe; sync_generated needs the agentic/package layer"
            exit 1
          fi
          just marketplace-build

          # release-please rewrites the version in whatever file its release-type owns, and its
          # YAML writer drops every comment in a file it touches. A repository whose manifest
          # carries a rationale nobody can infer from the keys defines `release-restore` to put
          # it back; the recipe is optional, so a repository with no comments to restore needs
          # nothing.
          if just --list 2>/dev/null | grep -q 'release-restore'; then
            just release-restore
          fi

          if git diff --quiet; then
            echo "catalogs already in sync"
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git commit -m "chore: sync the marketplace catalogs to the released versions"
          # The credential in the URL rather than in `.git/config`, so nothing persists it.
          git push "https://x-access-token:$GH_TOKEN@github.com/$GITHUB_REPOSITORY" "HEAD:$RELEASE_BRANCH"
{%- endif %}
