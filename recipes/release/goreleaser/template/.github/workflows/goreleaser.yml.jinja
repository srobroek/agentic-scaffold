name: Publish binaries

# Triggered by the tag, which release-please pushes. That is the whole division of labour:
# release-please computes the next version from the Conventional Commit subjects, writes the
# changelog, and tags; this reacts to the tag and attaches what it built.
#
# Not part of the gate. A release runs after a merge, and a required check that only fires on
# a tag would never report on a pull request.

on:
  push:
    tags:
      - "v*"

permissions:
  contents: read

jobs:
  publish:
    name: Publish
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(30, true) }}
    permissions:
      # Attaching assets to the release release-please created.
      contents: write
{%- if goreleaser_sbom %}
      # The attestation is a Sigstore bundle signed with a short-lived certificate from a
      # workflow OIDC token. Without id-token the action cannot get one, and it fails rather
      # than publishing an unsigned attestation.
      id-token: write
      # attest-build-provenance writes the bundle to the repository's attestation store.
      attestations: write
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The full history: goreleaser derives the version and the previous tag from it,
          # and a shallow clone has neither.
          fetch-depth: 0
          persist-credentials: false

      # `cache: false`, unlike every other Go job here. This one publishes artefacts, and a
      # poisoned cache entry would end up inside a binary users download: zizmor reports the
      # combination as cache-poisoning. A release is infrequent, so a cold module download
      # costs seconds that nobody is waiting on.
      - uses: actions/setup-go@d35c59abb061a4a6fb18e82ac0862c26744d6ab5 # v5.5.0
        with:
          # go.mod carries the version `go mod init` wrote, so nothing here can drift from it.
          go-version-file: go.mod
          cache: false

{%- if goreleaser_sbom %}

      # goreleaser's `sboms` block shells out to syft and does not install it. Without this
      # the release fails at the cataloguing step, after the binaries are already built.
      - name: Install syft
        uses: anchore/sbom-action/download-syft@e22c389904149dbc22b58101806040fa8d37a610 # v0.24.0
        with:
          syft-version: "v{{ syft_version }}"
{%- endif %}

      - name: Publish
        uses: goreleaser/goreleaser-action@f06c13b6b1a9625abc9e6e439d9c05a8f2190e94 # v7.2.3
        with:
          version: "~> {{ goreleaser_version.rsplit('.', 1)[0] }}"
          args: release --clean
        env:
          # The workflow's own token. goreleaser needs write access to attach the assets, and
          # `release.mode: append` means it adds to the release rather than replacing its
          # notes.
          GITHUB_TOKEN: ${{ '{{' }} secrets.GITHUB_TOKEN }}
{%- if goreleaser_sbom %}

      # An sboms block that produced nothing is a silent downgrade to no SBOM at all, and the
      # release would otherwise succeed looking attested. Measured against goreleaser 2.17.1
      # and syft 1.50.0: four archives produced four `<archive>.sbom.json` files beside them,
      # ~3.8KB each. goreleaser attaches each one to the release as its own asset.
      - name: Check that the SBOMs exist
        shell: bash
        # In the template this body sits in `{{ '{%' }} raw {{ '%}' }}`: bash's array-length
        # `${{ '{' }}#name[@]}` opens jinja's comment tag, and copier fails with "Missing end
        # of comment tag" without naming the line.
        run: |
          {%- raw %}
          set -euo pipefail
          # nullglob so an unmatched pattern expands to nothing rather than to itself, which
          # would otherwise make the loop run once on a file named `dist/*.sbom.json`.
          shopt -s nullglob
          sboms=(dist/*.sbom.json)
          # Emptiness tested with the `+x` form rather than a length: under `set -u` an empty
          # array counts as unbound on the runner's bash, so expanding it directly aborts with
          # "unbound variable" instead of reaching the message below.
          if [ -z "${sboms[*]+x}" ]; then
            echo "::error::sboms is enabled but dist/ holds no .sbom.json"
            exit 1
          fi
          for sbom in "${sboms[@]}"; do
            subject="${sbom%.sbom.json}"
            [ -f "$subject" ] || { echo "::error::no subject artefact for $sbom"; exit 1; }
          done
          echo "${#sboms[@]} SBOM(s), each paired with its archive"
          {%- endraw %}

      # After the publish, and deliberately: the subject is a digest, and a digest only exists
      # once the artefact does. Attesting a path that has not been built yet produces a bundle
      # for a file nobody downloads.
      #
      # Provenance only. `actions/attest-sbom` warns that it is deprecated in favour of
      # `actions/attest`, and both take `sbom-path` as ONE file capped at 16MB, while
      # goreleaser writes one SBOM per archive. A composite action cannot loop, so covering
      # four archives would need a matrix job, which means uploading and re-downloading dist/
      # to attest what this job already holds. The SBOMs ship as release assets instead, and
      # provenance covers every file including them.
      - name: Attest the build provenance
        uses: actions/attest-build-provenance@0f67c3f4856b2e3261c31976d6725780e5e4c373 # v4.1.1
        with:
          subject-path: |
            dist/*.tar.gz
            dist/*.zip
            dist/*.sbom.json
            dist/checksums.txt
{%- endif %}
