{#-
  packages/<name>/apm.yml -- the package's own manifest.

  A per-package manifest is required, not optional: `apm pack --check-versions`
  reports [no_apm_yml] for a package directory without one, and the version here is
  what release-please bumps through its extra-files entry.
-#}
name: {{ resolved_package }}
version: 0.1.0
description: >-
  {{ resolved_description }}
author: {{ author }}
license: {{ apm_license | default('Apache-2.0', true) }}

# `all` rather than a single harness: the package ships a skill, which every target
# can consume, so the consumer's project decides where it lands.
target: all
includes: auto

# Repeated from the root marketplace entry because the two are read by different
# tools: the root apm.yml drives the marketplace catalog, this drives `apm install`
# of the package on its own.
category: {{ category }}
tags:
{%- for tag in package_tags %}
  - {{ tag }}
{%- endfor %}
