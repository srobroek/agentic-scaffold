name: Pages

# The default topology: this repository holds the docs source and publishes itself, so the
# build needs no access to the code repository and no deploy key.
#
# Its own workflow rather than a job in the gate. Pages deployment needs `pages: write` and
# `id-token: write`, which the gate deliberately does not carry.

on:
  push:
    branches:
      - {{ default_branch }}
    # A change outside the site cannot alter the built output, so it does not republish.
    paths:
      - 'docs/site/**'
      - '.github/workflows/pages.yml'
  # Publishing without a commit, after a settings change or a failed run.
  workflow_dispatch:

permissions:
  contents: read

# Per ref, not global. Two pushes to the same branch serialise so the later one wins;
# two different refs do not cancel each other, which a global group would do.
concurrency:
  group: docs-${{ '{{' }} github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # The default leaves GITHUB_TOKEN in .git/config, where any later step can read
          # it. zizmor reports the default as a finding.
          persist-credentials: false

      - name: Install tools
        uses: jdx/mise-action@9e7f7633ff6f6d6048a9418a68d48f288f50eb14 # v4.2.3
        with:
          cache: true

      - name: Install dependencies
        working-directory: docs/site
        run: bun install --frozen-lockfile

      - name: Build
        working-directory: docs/site
        run: bun run build

      # GitHub Pages applies Jekyll unless told not to, which drops every directory whose
      # name opens with an underscore. Astro emits `_astro/`, so the assets 404 without
      # this and the pages render unstyled.
      - name: Disable Jekyll
        run: touch docs/site/dist/.nojekyll

      - uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6.0.0

      - uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: docs/site/dist

  deploy:
    name: Deploy
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes }}
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ '{{' }} steps.deploy.outputs.page_url }}
    steps:
      # `deploy-pages` clamps its own poll timeout and ignores a longer one, so a slow
      # first attempt fails on a timeout rather than waiting. The first run tolerates that
      # and the second picks up the same artefact.
      - id: deploy
        uses: actions/deploy-pages@cd2ce8fcbc39b97be8ca5fce6e763baed58fa128 # v5.0.0
        continue-on-error: true

      - name: Retry
        if: steps.deploy.outcome == 'failure'
        uses: actions/deploy-pages@cd2ce8fcbc39b97be8ca5fce6e763baed58fa128 # v5.0.0
