# apm resolves dependencies into apm_modules/, a lockfile-driven artefact rebuilt on
# install, so committing it would vendor every dependency.
apm_modules/

# apm pack writes bundle archives here. The marketplace catalogs it also writes
# (.claude-plugin/marketplace.json, .agents/plugins/marketplace.json) are COMMITTED, which
# is what lets a consumer resolve the marketplace from a clone with no build step; the
# archive directory is the throwaway part.
build/
