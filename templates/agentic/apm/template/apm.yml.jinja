{#-
  apm.yml -- the project-scoped agentic layer.

  APM has no separate source block: each dependency locator carries its own source
  inline, shaped owner/repo/packages/name#constraint.

  `includes: auto` is what makes `apm compile` weave the packages' context files
  into AGENTS.md, which is why docs/agents can carry pointers rather than prose.
-#}
name: {{ project_name | default('project', true) }}
version: 0.1.0
description: >-
  {{ description | default('Project-scoped agentic layer for ' ~ (project_name | default('project', true)), true) }}
target: {{ apm_target }}
includes: auto

dependencies:
  apm:
{%- if apm_packages %}
{%- for pkg in apm_packages %}
    - {{ pkg }}
{%- endfor %}
{%- else %}
    # No packages selected yet. `agentic/marketplace` reads the rendered layer set
    # and recommends against it: language-rust and rust-quality for a rust layer,
    # steering-infrastructure for terraform, speckit when SpecKit is in use.
    #
    # A locator is shaped owner/repo/packages/name#constraint, and carries its own
    # source, so a package resolves without a marketplace being registered first.
    []
{%- endif %}
