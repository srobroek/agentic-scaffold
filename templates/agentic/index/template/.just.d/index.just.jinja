# Agent index recipes, imported by the root justfile.

# Rebuild the directory map that answers "what exists and where"
[group('index')]
map:
    repomix

{% if index_full_pack %}
# Rebuild the contents pack. A grep target only: a Read hook refuses it whole
#
# Its own config, because repomix has --no-files but no --files, so the map's
# `files: false` cannot be overridden from the command line.
[group('index')]
map-full:
    repomix -c repomix-full.config.json

{% endif %}
# Rebuild the code graph
[group('index')]
graph:
    graphify update .
