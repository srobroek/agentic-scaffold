# Agent index recipes, imported by the root justfile.

# One artefact, searched rather than read. `rg` over the pack lists every path in
# 0.009s and finds one in 0.010s, so a second metadata-only artefact earns nothing
# and avoids repomix's `--no-files` trap: there is no `--files`, so a config
# carrying `files: false` cannot be overridden from the command line.

# Rebuild the pack, from the patterns in repomix.config.json
[group('index')]
pack:
    #!/usr/bin/env bash
    set -euo pipefail
    repomix
    # The HEAD the pack describes, recorded beside it. `just pack-check` compares against
    # this rather than a modification time, which a checkout or a clone resets.
    git rev-parse HEAD > repomix-full.xml.sha 2>/dev/null || true

# A pack goes stale on the first commit after it, and nothing about reading one says how old
# it is. Packing at session start was the alternative and costs every session 1.4 to 3.6
# seconds for a snapshot that may never be read: repomix has no cache, and two runs with
# identical arguments took 1.83s then 1.35s. This comparison costs about 80ms.

# Report how many commits the pack is behind
[group('index')]
pack-check:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f repomix-full.xml ]; then
      echo "no pack yet; run 'just pack'"
      exit 0
    fi
    if [ ! -f repomix-full.xml.sha ]; then
      echo "the pack has no HEAD marker, so its age is unknown; run 'just pack'"
      exit 0
    fi
    packed=$(cat repomix-full.xml.sha)
    head=$(git rev-parse HEAD)
    if [ "$packed" = "$head" ]; then
      echo "the pack is current"
      exit 0
    fi
    # `--count` rather than a boolean: how far behind decides whether a reader should
    # repack or ignore it.
    behind=$(git rev-list --count "$packed..$head" 2>/dev/null || echo "?")
    echo "the pack is $behind commit(s) behind HEAD; run 'just pack' to refresh it"

# --compress runs a parser over each file and keeps signatures while dropping bodies. It
# earns its keep only where that parser knows the language. Measured on this scaffold:
# 27,215 bytes to 14,321 over python sources, a 47 percent cut, against +0.1 percent over
# jinja templates, which it cannot parse and so slightly grows.
#
# So this is a second recipe rather than a flag on `pack`. A comment-dense or
# template-heavy tree is the case where the plain pack is smaller, and a pack that grew is
# a pack nobody checked.

# Pack only the source, with signatures kept and bodies dropped
[group('index')]
pack-code:
    repomix --compress --output repomix-code.xml

# `graphify update` has no output flag, so it writes graphify-out/ into the tree
# regardless. That is 9.9MB on 741 files and 60MB on 4,107, and unignored it gets
# packed into the next artefact.

# Rebuild the code graph
[group('index')]
graph:
    graphify update .

# Where a name appears, without walking the tree
[group('index')]
find pattern:
    @rg -o 'path="[^"]*{{ pattern }}[^"]*"' repomix-full.xml || echo "no path matches {{ pattern }}"

# The `</file>` close tag is self-delimiting, which is why xml works here and markdown
# does not: its boundary depends on the next heading existing.

# One file's contents out of the pack
[group('index')]
show path:
    @awk '/<file path="{{ path }}">/,/<\/file>/' repomix-full.xml
