name: Dependabot auto-merge

# Approves and merges dependabot's patch and minor action bumps. A major waits for a
# person, since that is the one whose changelog matters.
#
# `pull_request`, not `pull_request_target`. The target form runs with a writable token
# in the base repository's context, and zizmor rates it "almost always used insecurely";
# nothing here needs the pull request's code, so the plain trigger is enough. For a
# dependabot pull request, `secrets.GITHUB_TOKEN` is read-only regardless, which is why
# the merge uses an explicitly granted permission block rather than the default.

on:
  pull_request:
    types: [opened, synchronize, reopened]

permissions:
  contents: read

jobs:
  auto-merge:
    name: Auto-merge
    # `pull_request.user.login` rather than `github.actor`. The actor is whoever caused
    # the event and can be spoofed by pushing to a branch dependabot opened; the pull
    # request's author cannot. zizmor reports the actor form as `bot-conditions`.
    if: github.event.pull_request.user.login == 'dependabot[bot]'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
      pull-requests: write
    steps:
      # The semver level is not in the title reliably enough to parse, so it comes from
      # dependabot's own metadata.
      - name: Fetch dependabot metadata
        id: metadata
        uses: dependabot/fetch-metadata@25dd0e34f4fe68f24cc83900b1fe3fe149efef98 # v3.1.0
        with:
          github-token: ${{ '{{' }} secrets.GITHUB_TOKEN }}

      - name: Approve and merge patch and minor
        if: >-
          steps.metadata.outputs.update-type == 'version-update:semver-patch' ||
          steps.metadata.outputs.update-type == 'version-update:semver-minor'
        env:
          PR_URL: ${{ '{{' }} github.event.pull_request.html_url }}
          GH_TOKEN: ${{ '{{' }} secrets.GITHUB_TOKEN }}
        run: |
          gh pr review --approve "$PR_URL"
          # --auto waits for the required checks, so the gate still decides.
          gh pr merge --auto --squash "$PR_URL"
