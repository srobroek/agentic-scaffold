{#-
  infra/bootstrap/variables.tf
-#}
variable "project_name" {
  description = "Name prefix for the CI role."
  type        = string
  default     = "{{ project_name | default('project', true) }}"
}

variable "aws_region" {
  description = "Region the state bucket is created in. The main root module's backend must name the same one."
  type        = string
  default     = "{{ aws_region }}"
}

variable "state_bucket" {
  description = "Name of the state bucket. Must match `bucket` in every envs/<env>.tfbackend."
  type        = string
  default     = "{{ state_bucket | default(project_name | default('project', true) ~ '-tofu-state', true) }}"
}

variable "state_retention_days" {
  description = "How long a superseded state version is kept before expiry."
  type        = number
  default     = 90
}

variable "github_repository" {
  description = "owner/repo that may assume the CI role. Empty creates no OIDC provider and no role, for an account deployed only from a laptop."
  type        = string
  default     = ""
}

variable "github_allowed_refs" {
  description = "Which refs of that repository may assume the role. The default is the default branch and tags: a pull request ref is deliberately absent, since apply runs only after merge."
  type        = list(string)
  default     = ["ref:refs/heads/main", "ref:refs/tags/*"]
}
