# Worktrunk project configuration. Committed, so it is shared.
#
# A project-defined command is gated: worktrunk lists it and asks once, then
# remembers the answer in ~/.config/worktrunk/approvals.toml. Editing a command
# invalidates its approval, so a change here prompts again.
#
# User hooks run before project hooks and need no approval. Keep per-developer
# choices, such as which agent CLI writes commit messages, in user config.

# Blocking. A failure cancels the merge, which is the point: this is the same
# gate CI runs, so a merge cannot land what CI would reject.
pre-merge = "just check"

[forge]
platform = "{{ forge_platform }}"
{% if forge_hostname %}hostname = "{{ forge_hostname }}"
{% endif %}
[commit.generation]
# Appended to the commit and squash prompts inside a <project-guidance> block.
# Only template-append is honoured from a project file; the command and the main
# template stay in user config, since they describe the developer's environment.
template-append = """
- Conventional commit subjects: the changelog is generated from them.
- State what the change does, not what it was before.
- No authorship attribution, and no agent name in the message.
"""

[step.copy-ignored]
# Combined with the user config's excludes, and an exclude beats an include:
# verified by listing `target/` in both, where nothing copied. So anything a
# worktree should carry over must be absent from every exclude layer, including
# the user's.
#
# Only paths no `.worktreeinclude` would ever name belong here.
exclude = [
  ".beads/dolt/",
  "repomix.xml",
  ".pytest_cache/",
  ".ruff_cache/",
]
