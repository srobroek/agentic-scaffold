# What a new worktree copies from the primary checkout.
#
# Gitignore-style patterns. This narrows rather than adds: a path is copied only
# when it is both gitignored and listed here. The user config runs
# `wt step copy-ignored --require-include`, so without this file nothing copies
# and a new worktree starts cold.
#
# Name what is expensive to rebuild or impossible to recreate. Leave out anything
# a `just setup` can produce.
#
# An exclude beats an include, in this project's config and in the user's. The
# user config excludes `.venv/`, `venv/`, `target/`, and `.cargo/config.toml`, so
# listing any of those here copies nothing.

# Local environment, which cannot be regenerated.
.env
.env.local

# Agent index artefacts. Copying beats rebuilding on both: the pack is 1.3 to 3.2
# seconds to rebuild, the graph 6.9 seconds and 9.9MB, and neither holds an absolute
# path, so a copy is valid in any checkout.
repomix-full.xml
graphify-out/

# Installed dependency trees. Copying beats reinstalling: `apm install` is slow, and a
# warm refresh afterwards is 43ms for uv and 0.55s for cargo, so `setup-worktree` catches
# a branch whose lockfile moved without paying for a cold install.
#
# `.venv/` and `target/` are deliberately absent: the user config excludes both, and an
# exclude beats an include, so listing them here would copy nothing. That is why
# `setup-worktree` still runs the language installs -- for python and rust they are a
# cold install rather than a refresh.
apm_modules/
node_modules/

# Caches, valid at the HEAD a new worktree branches from.
.pytest_cache/
.ruff_cache/
.mypy_cache/
{% for pattern in worktree_includes %}
{{ pattern }}
{%- endfor %}
