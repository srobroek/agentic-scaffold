target-version = "py{{ python_version | replace('.', '') }}"
line-length = 100

[lint]
# S is bandit ported into ruff, so the security lint needs no separate tool.
# DOC is its pydoclint port: it compares documented params, returns, and raises
# against the real signature, catching a docstring that drifted after a refactor
# rather than one that is merely missing.
select = [
  "E", "F", "I", "N", "W", "UP", "B", "SIM", "TC",
  "ANN", "RUF", "PERF", "C4", "PT", "S", "DOC",
]

# DOC rules are preview-gated. Without this ruff prints "Selection `DOC` has no
# effect because preview is not enabled" and checks nothing.
preview = true

# D is deliberately absent. ruff has no per-rule severity, so selecting it makes a
# bare `ruff check` fail, and docstring presence is meant to be advisory. The
# advisory recipe passes --select D --exit-zero instead.

[lint.pydocstyle]
convention = "google"

[lint.per-file-ignores]
# A specific rule goes by NAME, not code: `preview = true` above turns on RUF201,
# which rejects "S101" here. A group prefix such as ANN is still accepted.
# A test asserts, and a bare assert is the point.
"tests/**" = ["assert", "ANN"]

# uv init writes a function into src/<pkg>/__init__.py, which the default
# lint.flake8-no-pep420 view of a package rejects. Selecting nothing here would
# fail on the scaffold before a line is written.
"**/__init__.py" = ["non-empty-init-module"]

[format]
quote-style = "double"
