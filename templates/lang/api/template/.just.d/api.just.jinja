{#-
  .just.d/api.just -- imported by the root justfile. Bodies inside `{% raw %}` because
  just shares jinja's `{{ }}`.
-#}
# API contract recipes, contributed by lang/api.

api_spec := "openapi.yaml"
api_baseline := "{{ api_baseline_ref }}"
api_severity := "{{ api_fail_severity }}"
{% raw %}
# vacuum's default threshold is error, and a missing description or absent operationId is
# reported at warn. Passing --fail-severity is what makes the gate catch contract drift
# rather than only malformed YAML.

# Lint the contract
[group('api')]
api-lint:
    vacuum lint --fail-severity {{ api_severity }} {{ api_spec }}

# The full report, including what the gate tolerates
[group('api')]
api-report:
    vacuum report --stdout {{ api_spec }}

# `--fail-on ERR` is mandatory, not decorative: oasdiff prints every breaking change and
# still exits 0 without it, so the check would pass while reporting the breakage.
# Verified against oasdiff 1.26.1, where removing an operation exited 0 bare and 1 with
# the flag.
#
# The baseline is read from the ref rather than a committed copy, so nothing has to be
# kept in step by hand.

# Fail when the contract breaks a consumer
[group('api')]
api-breaking:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! git rev-parse --verify --quiet "{{ api_baseline }}" >/dev/null; then
      echo "no baseline at {{ api_baseline }}; nothing to compare against" >&2
      exit 0
    fi
    base=$(mktemp)
    trap 'rm -f "$base"' EXIT
    if ! git show "{{ api_baseline }}:{{ api_spec }}" > "$base" 2>/dev/null; then
      echo "{{ api_spec }} is new at {{ api_baseline }}; no baseline to compare" >&2
      exit 0
    fi
    oasdiff breaking --fail-on ERR "$base" "{{ api_spec }}"

# Every change against the baseline, breaking or not
[group('api')]
api-diff:
    #!/usr/bin/env bash
    set -euo pipefail
    base=$(mktemp)
    trap 'rm -f "$base"' EXIT
    git show "{{ api_baseline }}:{{ api_spec }}" > "$base" 2>/dev/null || { echo "no baseline"; exit 0; }
    oasdiff changelog "$base" "{{ api_spec }}"

# Lint and check for breaking changes
[group('api')]
api: api-lint api-breaking
{% endraw %}
