{#-
  openapi.yaml -- the contract. A starter that passes `vacuum lint --fail-severity warn`
  as rendered, so the gate is green before the first endpoint is described rather than
  after someone fixes the scaffold.
-#}
openapi: 3.1.0

# vacuum reports a missing description, contact, or licence at warn, and the gate fails
# at warn by default, so all three are present from the start.
info:
  title: {{ api_title | default('Example API', true) }}
  version: "{{ api_version }}"
  description: >-
    Replace this with what the API is for. The contract is the source of truth: a client
    is generated from it, and `oasdiff` compares it against the baseline to decide
    whether a change breaks a consumer.
  contact:
    name: {{ org | default('The maintainers', true) }}
    url: {{ repo_url | default('https://example.com', true) }}
  license:
    name: {{ license | default('Apache-2.0', true) }}
    url: https://spdx.org/licenses/{{ license | default('Apache-2.0', true) }}.html

servers:
  - url: {{ api_server_url }}
    description: production

tags:
  - name: health
    description: Liveness and readiness.

paths:
  # A worked example rather than an empty object: `paths: {}` lints clean while
  # describing nothing, so the first real endpoint has no shape to follow.
  /health:
    get:
      operationId: getHealth
      summary: Report service health
      description: Returns ok while the service can serve requests.
      tags: [health]
      responses:
        "200":
          description: The service is healthy.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Health"
              # vacuum reports a media type with no example at warn, and the gate fails
              # at warn, so every schema and property below carries one. Verified: the
              # starter scored 98/100 with four `missing examples` warnings until they
              # were added.
              example:
                status: ok

components:
  schemas:
    Health:
      type: object
      description: The health payload.
      required: [status]
      example:
        status: ok
      properties:
        status:
          type: string
          description: Always `ok` when the service is serving.
          enum: [ok]
          example: ok
