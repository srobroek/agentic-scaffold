name: Lint API

# Contributed by lang/api. Both jobs are contract checks, so they sit in one workflow
# rather than the lint/test pair a language layer contributes.

on:
  workflow_call:
    inputs:
      baseline-ref:
        description: >-
          Ref the breaking-change check compares against. A pull request should pass its
          merge base; the default branch is the fallback.
        required: false
        type: string
        default: "{{ api_baseline_ref }}"

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15, true) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          # The default leaves GITHUB_TOKEN in .git/config, where any later step can
          # read it. zizmor reports the default as a finding.
          persist-credentials: false

      - name: Install tools
        uses: jdx/mise-action@9e7f7633ff6f6d6048a9418a68d48f288f50eb14 # v4.2.3
        with:
          cache: true

      - name: Lint the contract
        run: just api-lint

  breaking:
    name: Breaking changes
    runs-on: ubuntu-latest
    timeout-minutes: {{ job_timeout_minutes | default(15, true) }}
    steps:
      # The full history, not a shallow clone: the check reads the spec out of the
      # baseline ref, and a depth-1 fetch has no such object.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Install tools
        uses: jdx/mise-action@9e7f7633ff6f6d6048a9418a68d48f288f50eb14 # v4.2.3
        with:
          cache: true

      # `just api-breaking` passes --fail-on ERR, which is what makes this gate: oasdiff
      # prints every breaking change and exits 0 without it.
      - name: Fail on a breaking change
        env:
          BASELINE: ${{ '{{' }} inputs.baseline-ref }}
        run: just api-breaking

      # Posted rather than only logged, so a reviewer sees the contract delta beside the
      # diff that caused it.
      - name: Summarise the changes
        if: always()
        run: |
          {
            echo "### API contract changes"
            echo
            echo '```'
            just api-diff 2>&1 || echo "no baseline to compare against"
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
